---
import Base from '../layouts/Base.astro';
---

<Base title="not found — luqmaan.dev" description="This page doesn't exist.">
  <main class="page">
    <header class="site-header">
      <a href="/" class="site-logo">luqmaan.dev</a>
      <a href="/connect" class="nav-link">connect →</a>
    </header>

    <p class="nf-code">404</p>
    <h1 class="nf-title">Nothing here.</h1>
    <p class="nf-text">
      That page doesn't exist, or it's moved. <a href="/" class="nf-link">← back home</a>
    </p>
  </main>
</Base>

<style>
  .nf-code {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 12px;
    color: #E53935;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .nf-title {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    color: #000000;
    margin-bottom: 12px;
  }

  .nf-text {
    font-size: 15px;
    color: #777777;
    line-height: 1.6;
  }

  .nf-link {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 13px;
    color: #E53935;
    text-decoration: none;
  }

  .nf-link:hover {
    text-decoration: underline;
  }
</style>
